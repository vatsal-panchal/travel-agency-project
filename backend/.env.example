# Environment mode: development | production | test
NODE_ENV=development

# Server port (default 5000)
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/travel_agency

# JWT Secret for access token (must be at least 32 characters, generated via crypto)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here

# JWT Secret for refresh token (must be different from JWT_ACCESS_SECRET)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here

# Access token expiration time (e.g. 15m)
ACCESS_TOKEN_EXPIRES=15m

# Refresh token expiration time in days (e.g. 7)
REFRESH_TOKEN_EXPIRES_DAYS=7

# Allowed client origins separated by comma (no trailing slashes)
CLIENT_URL=http://localhost:5173

# Cookie cross-site behavior: true for cross-domain frontend (SameSite=None, Secure=true)
COOKIE_CROSS_SITE=false

# Admin initial seed credentials
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@travel.com
ADMIN_PASSWORD=Admin@12345

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=

# Groq Model identifier (e.g. llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
